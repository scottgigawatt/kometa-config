#
# .gitattributes: Normalize repository text while treating artwork as binary.
#

#
# Normalize repository text to portable LF line endings.
#
* text=auto eol=lf

#
# Keep artwork byte-for-byte intact instead of applying text normalization.
#
*.gif binary
*.jpeg binary
*.jpg binary
*.png binary
*.psd binary
*.tbn binary
*.webp binary
