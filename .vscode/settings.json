    //
    // Keep Makefile Tools from inventing a configure step for this project.
    //
    "makefile.configureOnOpen": false,

    //
    // Resolve helper imports from the ignored local development environment.
    // Existing workspaces may need Python: Select Interpreter once after setup.
    //
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv",

    //
    // Associate special repository files with their correct language modes.
    //
    "files.associations": {
        ".prettierrc.json5": "jsonc",
        ".secrets.baseline": "jsonc",
        "**/CODEOWNERS": "plaintext"
    },

    //
    // Mirror EditorConfig indentation while disabling YAML format-on-save so
    // Kometa key ordering and nearby explanatory comments remain deliberate.
    //
    "[yaml]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[github-actions-workflow]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[jsonc]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[makefile]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": false
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false,
        "editor.wordWrap": "on"
    },
    "[shellscript]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },

    //
    // Use the checked-in Prettier configuration only for supported languages.
    // Keep global module discovery disabled so formatting stays workspace-safe.
    //
    "prettier.requireConfig": true,
    "prettier.resolveGlobalModules": false,
    "prettier.useEditorConfig": true,

    //
    // Run make validate-editor to generate the pinned config schema with narrow
    // runtime-verified compatibility fixes. Other families use upstream schemas.
    //
    "yaml.format.enable": true,
    "yaml.schemaStore.enable": true,
    "yaml.schemas": {
        "https://json.schemastore.org/github-workflow.json": [
            "**/.github/workflows/*.yml",
            "**/.github/workflows/*.yaml"
        ],
        "https://json.schemastore.org/pre-commit-config.json": ".pre-commit-config.yaml",
        "./.vscode/.schemas/config-schema.json": [
            "config.yml",
            "tests/kometa/config.yml",
            "tests/kometa/collections-config.yml"
        ],
        "https://raw.githubusercontent.com/Kometa-Team/Kometa/v2.5.0/json-schema/collection-schema.json": [
            "movies/**/*.yml",
            "scheduled/**/*.yml",
            "shows/**/*.yml",
            "tests/kometa/smoke-collections.yml"
        ],
        "https://raw.githubusercontent.com/Kometa-Team/Kometa/v2.5.0/json-schema/overlay-schema.json": "overlays/**/*.yml",
        "https://raw.githubusercontent.com/Kometa-Team/Kometa/v2.5.0/json-schema/playlist-schema.json": "playlists/**/*.yml"
    },
    "yaml.validate": true,
    "yaml.yamlVersion": "1.2"
}
