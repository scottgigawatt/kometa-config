        "unconfigured",
        "unmanaged",
        "Weezer's",
        "Wizarding",
        "xmen"
    ],

    "makefile.configureOnOpen": false,

    "files.associations": {
        ".prettierrc.json5": "jsonc",
        ".secrets.baseline": "jsonc",
        "**/CODEOWNERS": "plaintext"
    },

    "[yaml]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[github-actions-workflow]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[jsonc]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[makefile]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": false
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[shellscript]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    "prettier.requireConfig": true,
    "prettier.resolveGlobalModules": false,
    "prettier.useEditorConfig": true,

    "yaml.format.enable": true,
    "yaml.schemaStore.enable": true,
    "yaml.schemas": {
        "https://json.schemastore.org/github-workflow.json": [
            "**/.github/workflows/*.yml",
            "**/.github/workflows/*.yaml"
        ],
        "https://json.schemastore.org/pre-commit-config.json": ".pre-commit-config.yaml",
        "https://raw.githubusercontent.com/Kometa-Team/Kometa/v2.4.8/json-schema/config-schema.json": [
            "config.yml",
            "tests/kometa/config.yml"
        ],
        "https://raw.githubusercontent.com/Kometa-Team/Kometa/v2.4.8/json-schema/collection-schema.json": [
            "movies/**/*.yml",
            "scheduled/**/*.yml",
            "shows/**/*.yml",
            "tests/kometa/collections.yml"
        ],
        "https://raw.githubusercontent.com/Kometa-Team/Kometa/v2.4.8/json-schema/overlay-schema.json": "overlays/**/*.yml",
        "https://raw.githubusercontent.com/Kometa-Team/Kometa/v2.4.8/json-schema/playlist-schema.json": "playlists/**/*.yml"
    },
    "yaml.validate": true,
    "yaml.yamlVersion": "1.2"
}
