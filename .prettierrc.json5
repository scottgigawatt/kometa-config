    // Licensed under the Apache License, Version 2.0.
    //
    // .prettierrc.json5: Configure explicit, on-demand formatting for the
    //                    repository file types supported by Prettier.
    //

    "$schema": "https://json.schemastore.org/prettierrc",
    "endOfLine": "lf",
    "printWidth": 100,
    "proseWrap": "preserve",
    "quoteProps": "preserve",
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false,
    "overrides": [
        {
            "files": ["*.json", "*.jsonc", "*.json5"],
            "options": {
                "tabWidth": 4
            }
        }
    ]
}
