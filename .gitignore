#
# .gitignore: Exclude private credentials, Kometa runtime state, generated
#             PATTRMM inputs, and local workstation artifacts.
#

#
# Local workstation metadata and disposable editor backups.
#
.DS_Store
*.bak
.ruff_cache/
.venv/
.vscode/.schemas/
__pycache__/
*.py[cod]

#
# Private credentials and environment files; checked-in examples remain
# available as safe templates.
#
.secrets/
auth.yml
.env
.env.*
*.env
!example*.env

#
# Kometa logs, caches, identifiers, and isolated test-library state.
#
logs/
*.cache
UUID
.kometa-test/

#
# PATTRMM writes these runtime inputs into the mounted Kometa configuration
# tree; the generator remains their source of truth.
#
**/*-by-size.yml
**/*-in-history.yml
**/*-returning-soon-metadata.yml
**/*-returning-soon-overlay.yml
**/*-returning-soon-collection.yml
**/*-returning-soon-collection.txt
**/*-in-history.txt
**/*-by-size.txt

#
# Neo writes paired collection definitions and Plex-GUID lists, plus status overlays.
# Generated names retain upstream underscores and optional history instance numbers.
#
/generated/pattrmm/
**/*-by-size-collection.yml
**/*-by-size-collection.txt
**/*-in-history-collection.yml
**/*-in-history-collection.txt
**/*-in-history-[0-9]*-collection.yml
**/*-in-history-[0-9]*-collection.txt
**/*-returning_soon-collection.yml
**/*-returning_soon-collection.txt
**/*-new_airing_next-collection.yml
**/*-new_airing_next-collection.txt
**/*-new_series-collection.yml
**/*-new_series-collection.txt
**/*-airing_next-collection.yml
**/*-airing_next-collection.txt
**/*-airing-collection.yml
**/*-airing-collection.txt
**/*-season_finale-collection.yml
**/*-season_finale-collection.txt
**/*-returning-collection.yml
**/*-returning-collection.txt
**/*-canceled-collection.yml
**/*-canceled-collection.txt
**/*-ended-collection.yml
**/*-ended-collection.txt
**/*-extended_status-overlay.yml
