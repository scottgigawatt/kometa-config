#
# example.test.env: Private connection values required by the Plex test-library
#                   workflow. Copy to .secrets/test.env and edit that copy.
#

#
# Plex connection values for the isolated fixture libraries. Use a LAN-reachable
# Plex URL because the test runs inside a local container.
#
KOMETA_PLEXURL=http://PLEX_HOST:32400
KOMETA_PLEXTOKEN=

#
# TMDb supplies metadata required by the smoke collection and default overlays.
#
KOMETA_TMDBAPIKEY=
