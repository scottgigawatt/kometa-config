{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":enablePreCommit",
    ],
    timezone: "America/New_York",
    schedule: ["* 0-7 1 * *"],
    automergeSchedule: ["* 0-7 1 * *"],
    updateNotScheduled: false,
    prConcurrentLimit: 2,
    dependencyDashboard: {
        enabled: true,
    },
    automerge: true,
    automergeType: "pr",
    automergeStrategy: "squash",
    platformAutomerge: false,
    rebaseWhen: "behind-base-branch",
    labels: ["dependencies"],
    assignees: ["scottgigawatt"],
    reviewers: ["scottgigawatt"],
    vulnerabilityAlerts: {
        enabled: true,
        dependencyDashboardApproval: false,
        groupName: null,
        automerge: false,
        schedule: ["at any time"],
        automergeSchedule: ["at any time"],
        updateNotScheduled: true,
    },
    enabledManagers: [
        "custom.regex",
        "github-actions",
        "pip_requirements",
        "pre-commit",
    ],
    customManagers: [
        {
            customType: "regex",
            managerFilePatterns: ["/^Makefile$/"],
            matchStrings: [
                "KOMETA_IMAGE \\?= (?<depName>kometateam/kometa):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
            ],
            datasourceTemplate: "docker",
            versioningTemplate: "docker",
        },
        {
            customType: "regex",
            managerFilePatterns: ["/^\\.vscode/settings\\.json$/"],
            matchStrings: [
                "https://raw\\.githubusercontent\\.com/Kometa-Team/Kometa/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/json-schema/(?:config|collection|overlay|playlist)-schema\\.json",
            ],
            depNameTemplate: "Kometa-Team/Kometa",
            datasourceTemplate: "github-tags",
            versioningTemplate: "semver",
        },
    ],
    packageRules: [
        {
            groupName: "GitHub Actions",
            matchManagers: ["github-actions"],
        },
        {
            groupName: "pre-commit hooks",
            matchManagers: ["pre-commit"],
        },
        {
            groupName: "Kometa runtime and schemas",
            matchDepNames: ["kometateam/kometa", "Kometa-Team/Kometa"],
        },
        {
            matchDepNames: ["kometateam/kometa"],
            pinDigests: true,
        },
        {
            matchManagers: ["pip_requirements"],
            rangeStrategy: "pin",
        },
        {
            matchUpdateTypes: ["minor", "patch", "pin", "digest"],
            groupName: "monthly maintenance",
        },
        {
            matchDatasources: ["docker"],
            schedule: ["* 0-7 * * 1"],
            automergeSchedule: ["* 0-7 * * 1"],
            groupName: "weekly production dependencies",
        },
        {
            matchPackageNames: ["kometateam/kometa", "Kometa-Team/Kometa"],
            schedule: ["* 0-7 * * 1"],
            automergeSchedule: ["* 0-7 * * 1"],
            groupName: "weekly production dependencies",
        },
        {
            matchUpdateTypes: ["major"],
            dependencyDashboardApproval: true,
            automerge: false,
            groupName: null,
        },
        {
            matchUpdateTypes: ["major"],
            matchPackageNames: ["kometateam/kometa", "Kometa-Team/Kometa"],
            groupName: "Kometa runtime and schemas",
        },
    ],
}
